generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String              @id @default(uuid())
  name                     String
  email                    String              @unique
  password                 String?
  provider                 String              @default("credentials")
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt
  role                     String              @default("USER")
  phone                    String?
  isVerified               Boolean             @default(false)
  verificationToken        String?
  verificationTokenExpires DateTime?
  resetPasswordToken       String?
  resetPasswordExpires     DateTime?
  adminCredits             AdminCredits?
  attempts                 Attempt[]
  codingAttempts           CodingAttempt[]
  codingInvitations        CodingInvitation[]
  codingTests              CodingTest[]
  creditTransactions       CreditTransaction[]
  profile                  Profile?
  resumes                  Resume[]
  tests                    Test[]
}

model Profile {
  id             String   @id @default(uuid())
  college        String?
  branch         String?
  graduationYear Int?
  userId         String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Resume {
  id        String          @id @default(uuid())
  title     String
  fileUrl   String
  fileType  String
  isActive  Boolean         @default(true)
  userId    String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysis  ResumeAnalysis?
}

model ResumeAnalysis {
  id            String   @id @default(uuid())
  skills        Json?
  education     Json?
  projects      Json?
  resumeId      String   @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  rawText       String?
  atsScore      Int?     @default(0)
  missingSkills Json?
  resume        Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
}

model Test {
  id            String           @id @default(uuid())
  title         String
  duration      Int
  createdAt     DateTime         @default(now())
  isPractice    Boolean          @default(false)
  securityLevel SecurityLevel    @default(BASIC)
  createdById   String?
  attempts      Attempt[]
  questions     Question[]
  createdBy     User?            @relation(fields: [createdById], references: [id])
  invitations   TestInvitation[]
  modules       TestModule[]
}

model Question {
  id            String   @id @default(uuid())
  question      String
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  correctAnswer String
  testId        String
  createdAt     DateTime @default(now())
  test          Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
}

model Attempt {
  id                   String            @id @default(uuid())
  score                Int
  totalQuestions       Int
  percentage           Float
  tabSwitches          Int               @default(0)
  fullscreenViolations Int               @default(0)
  userId               String
  testId               String
  createdAt            DateTime          @default(now())
  copyAttempts         Int               @default(0)
  rightClickAttempts   Int               @default(0)
  test                 Test              @relation(fields: [testId], references: [id], onDelete: Cascade)
  user                 User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  proctoringReport     ProctoringReport?
}

model QuestionBank {
  id            String   @id @default(uuid())
  category      String
  question      String
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  correctAnswer String
  createdAt     DateTime @default(now())
}

model TestInvitation {
  id        String   @id @default(uuid())
  email     String
  status    String   @default("PENDING")
  testId    String
  createdAt DateTime @default(now())
  test      Test     @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@unique([email, testId])
}

model TestModule {
  id            String @id @default(uuid())
  module        String
  questionCount Int
  testId        String
  test          Test   @relation(fields: [testId], references: [id], onDelete: Cascade)
}

model ProctoringReport {
  id                        String   @id @default(uuid())
  attemptId                 String   @unique
  cameraEnabled             Boolean  @default(false)
  microphoneEnabled         Boolean  @default(false)
  tabSwitches               Int      @default(0)
  fullscreenViolations      Int      @default(0)
  idleEvents                Int      @default(0)
  resizeEvents              Int      @default(0)
  riskScore                 Int      @default(0)
  securityScore             Int      @default(100)
  createdAt                 DateTime @default(now())
  faceMissingEvents         Int      @default(0)
  focusLossEvents           Int      @default(0)
  multipleFaceEvents        Int      @default(0)
  noiseWarnings             Int      @default(0)
  possibleMultiMonitor      Boolean  @default(false)
  suspicionLevel            String   @default("LOW")
  copyAttempts              Int      @default(0)
  rightClickAttempts        Int      @default(0)
  cameraDisconnectEvents    Int      @default(0)
  microphoneDisconnectEvents Int     @default(0)
  attempt                   Attempt  @relation(fields: [attemptId], references: [id])
}

model CodingTest {
  id            String               @id @default(uuid())
  title         String
  description   String?
  duration      Int
  securityLevel CodingSecurityLevel
  createdById   String
  isActive      Boolean              @default(true)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  attempts      CodingAttempt[]
  invitations   CodingInvitation[]
  createdBy     User                 @relation(fields: [createdById], references: [id])
  questions     CodingTestQuestion[]
}

model CodingQuestionBank {
  id              String                   @id @default(uuid())
  title           String
  category        String
  difficulty      CodingDifficulty
  description     String
  inputFormat     String?
  outputFormat    String?
  constraints     String?
  examples        Json?
  starterCodes    Json?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  slug            String                   @unique
  floatPrecision  Int                      @default(6)
  outputValidator OutputValidator          @default(EXACT)
  testCases       CodingQuestionTestCase[]
  submissions     CodingSubmission[]
  questions       CodingTestQuestion[]
}

model CodingQuestionTestCase {
  id             String             @id @default(uuid())
  questionId     String
  input          String
  expectedOutput String
  explanation    String?
  isHidden       Boolean            @default(false)
  createdAt      DateTime           @default(now())
  question       CodingQuestionBank @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model CodingTestQuestion {
  id           String             @id @default(uuid())
  codingTestId String
  questionId   String
  order        Int
  scoreWeight  Int                @default(100)
  codingTest   CodingTest         @relation(fields: [codingTestId], references: [id], onDelete: Cascade)
  question     CodingQuestionBank @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([codingTestId, questionId])
}

model CodingInvitation {
  id             String     @id @default(uuid())
  codingTestId   String
  candidateEmail String
  userId         String?
  status         String     @default("PENDING")
  invitedAt      DateTime   @default(now())
  createdAt      DateTime   @default(now())
  codingTest     CodingTest @relation(fields: [codingTestId], references: [id], onDelete: Cascade)
  user           User?      @relation(fields: [userId], references: [id])

  @@unique([codingTestId, candidateEmail])
}

model CodingAttempt {
  id                 String                @id @default(uuid())
  codingTestId       String
  userId             String
  candidateEmail     String
  status             String                @default("IN_PROGRESS")
  totalQuestions     Int                   @default(0)
  completedQuestions Int                   @default(0)
  totalScore         Int                   @default(0)
  percentage         Float                 @default(0)
  startedAt          DateTime              @default(now())
  submittedAt        DateTime?
  createdAt          DateTime              @default(now())
  riskLevel          String?               @default("LOW")
  riskScore          Int?                  @default(0)
  codingTest         CodingTest            @relation(fields: [codingTestId], references: [id], onDelete: Cascade)
  user               User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  securityEvents     CodingSecurityEvent[]
  submissions        CodingSubmission[]

  @@unique([codingTestId, userId])
}

model CodingSubmission {
  id               String             @id @default(uuid())
  attemptId        String
  questionId       String
  language         String
  status           String
  passedCases      Int                @default(0)
  totalCases       Int                @default(0)
  score            Int                @default(0)
  submissionNumber Int                @default(1)
  createdAt        DateTime           @default(now())
  executionTime    Float?
  memoryUsed       Int?
  sourceCode       String?
  attempt          CodingAttempt      @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question         CodingQuestionBank @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model CodingSecurityEvent {
  id            String        @id @default(uuid())
  attemptId     String
  eventType     String
  details       Json?
  createdAt     DateTime      @default(now())
  screenshotUrl String?
  attempt       CodingAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
}

/// One wallet per admin user. Balance defaults to 20 (welcome bonus).
model AdminCredits {
  id        String   @id @default(uuid())
  userId    String   @unique
  balance   Int      @default(20)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Every credit movement (purchase, usage, bonus, refund, admin adjustment).
model CreditTransaction {
  id           String                @id @default(uuid())
  userId       String
  type         CreditTransactionType
  credits      Int
  balanceAfter Int
  description  String
  referenceId  String?
  createdAt    DateTime              @default(now())
  metadata     Json?
  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Purchasable credit packs shown in the billing page.
model CreditPack {
  id           String   @id @default(uuid())
  name         String
  credits      Int
  bonusCredits Int      @default(0)
  price        Float
  description  String?
  isPopular    Boolean  @default(false)
  isActive     Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
}

enum SecurityLevel {
  BASIC
  PRO
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum CodingCategory {
  ARRAYS
  STRINGS
  LINKED_LIST
  STACK
  QUEUE
  TREE
  GRAPH
  DP
  GREEDY
  BINARY_SEARCH
  RECURSION
  MATH
}

enum CodingDifficulty {
  EASY
  MEDIUM
  HARD
}

enum CodingSecurityLevel {
  BASIC
  PRO
}

enum OutputValidator {
  EXACT
  IGNORE_ORDER
  SET_COMPARE
  FLOAT_COMPARE
  CUSTOM
}

enum CreditTransactionType {
  PURCHASE
  USAGE
  BONUS
  REFUND
  ADMIN
}
